CAPI=3:

name : ::fifo:1.3-r1
description : Generic FIFO

# CAPI=2 selected some files by the top level's tool (`tool_<name>` flags).
# CAPI=3 has no tool in its context, so a top level building this core with
# that tool sets its variable: `vars: {tool_icarus: true}` in its
# target, or `--var +tool_icarus` on the command line.
vars:
  tool_icarus:
    datatype: bool
    default: false
    description: The top level builds with Icarus Verilog
  tool_isim:
    datatype: bool
    default: false
    description: The top level builds with ISim
  tool_modelsim:
    datatype: bool
    default: false
    description: The top level builds with ModelSim
  tool_quartus:
    datatype: bool
    default: false
    description: The top level builds with Quartus

filesets:
  rtl:
    files:
      - rtl/verilog/simple_dpram_sclk.v
      - rtl/verilog/fifo.v
      - rtl/verilog/fifo_fwft_adapter.v
      - rtl/verilog/fifo_fwft.v
      - rtl/verilog/dual_clock_fifo.v
    file_type : verilogSource

  bfm:
    files:
      - bench/fifo_reader.v
      - bench/fifo_fwft_reader.v
      - bench/fifo_writer.v
    file_type : verilogSource

  tb:
    files:
      - bench/fifo_tester.v
      - bench/dual_clock_fifo_tb.v
      - bench/fifo_fwft_tb.v
      - bench/fifo_tb.v
    file_type : verilogSource
    depend : [">=::vlog_tb_utils:1.1"]

  constraints:
    files :
      - if: "vars.tool_quartus"
        add:
          - data/fifo.sdc: {file_type: SDC}

parameters:
  read_rate:
    datatype    : str
    description : FIFO read rate
    paramtype   : plusarg

  write_rate:
    datatype    : str
    description : FIFO write rate
    paramtype   : plusarg

  data_width:
    datatype    : int
    description : FIFO data width
    paramtype   : vlogparam

  depth_width:
    datatype    : int
    description : 2**(FIFO depth)
    paramtype   : vlogparam

targets:
  default:
    filesets :
      - rtl
      - constraints
      - if: "vars.tool_icarus || vars.tool_isim || vars.tool_modelsim"
        add: [bfm]
  fifo_fwft_tb:
    vars: {tool_icarus: true}
    flow: sim
    flags: {tool: icarus}
    flow_options:
      tool: icarus
    description : Testbench for First Word Fall Through FIFO
    filesets : [rtl, bfm, tb]
    parameters : [read_rate, write_rate, data_width, depth_width]
    toplevel : fifo_fwft_tb

  dual_clock_fifo_tb:
    extends: fifo_fwft_tb
    description : Testbench for dual clock FIFO
    toplevel : dual_clock_fifo_tb

  fifo_tb:
    extends: fifo_fwft_tb
    description : Testbench single clock FIFO
    toplevel : fifo_tb

provider:
  name    : github
  user    : olofk
  repo    : fifo
  version : v1.3
