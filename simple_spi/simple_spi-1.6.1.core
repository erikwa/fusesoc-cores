CAPI=3:

name : ::simple_spi:1.6.1
description : OpenCores SPI Core

filesets:
  rtl:
    files:
      - rtl/verilog/fifo4.v
      - rtl/verilog/simple_spi_top.v
    file_type : verilogSource

  tb:
    files:
      - bench/verilog/tst_bench_top.v
      - bench/verilog/spi_slave_model.v
      - bench/verilog/wb_master_model.v
    file_type : verilogSource
    depend: ["::vlog_tb_utils"]

targets:
  default:
    filesets: [rtl]

  lint:
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    filesets : [rtl]
    flow_options: {tool: verilator, mode: lint-only}
    toplevel : simple_spi

  sim:
    vars: {tool_icarus: true}
    flow: sim
    flags: {tool: icarus}
    flow_options:
      tool: icarus
    filesets: [rtl,tb]
    toplevel: tst_bench_top

provider:
  name    : github
  user    : olofk
  repo    : simple_spi
  version : v1.6.1
