CAPI=3:

name : ::serv:1.1.0

# CAPI=2 selected some files by the top level's tool (`tool_<name>` flags).
# CAPI=3 has no tool in its context, so a top level building this core with
# that tool sets its variable: `vars: {tool_verilator: true}` in its
# target, or `--var +tool_verilator` on the command line.
vars:
  tool_verilator:
    datatype: bool
    default: false
    description: The top level builds with Verilator

filesets:
  core:
    files:
      - if: "vars.tool_verilator"
        add:
          - data/verilator_waiver.vlt: {file_type: vlt}
      - rtl/serv_bufreg.v
      - rtl/serv_alu.v
      - rtl/serv_csr.v
      - rtl/serv_ctrl.v
      - rtl/serv_decode.v
      - rtl/serv_immdec.v
      - rtl/serv_mem_if.v
      - rtl/serv_rf_if.v
      - rtl/serv_rf_ram_if.v
      - rtl/serv_rf_ram.v
      - rtl/serv_state.v
      - rtl/serv_top.v
      - rtl/serv_rf_top.v
    file_type : verilogSource

targets:
  default:
    filesets : [core]
    parameters :
      - if: "core.is_toplevel"
        add: [PRE_REGISTER, RESET_STRATEGY]
      - RISCV_FORMAL
      - SERV_CLEAR_RAM
      - if: "core.is_toplevel"
        add: [WITH_CSR]
    toplevel: [{if: "core.is_toplevel", add: [serv_rf_top]}]

  lint:
    vars: {tool_verilator: true}
    flow: lint
    filesets : [core]
    flow_options:
      tool: verilator
      mode : lint-only
      verilator_options:
        - "-Wall"
    toplevel : serv_rf_top

parameters:
  PRE_REGISTER:
    datatype    : int
    description : Register signals before or after the decoder
    paramtype   : vlogparam

  RESET_STRATEGY:
    datatype : str
    paramtype : vlogparam

  RISCV_FORMAL:
    datatype  : bool
    paramtype : vlogdefine

  SERV_CLEAR_RAM:
    datatype  : bool
    paramtype : vlogdefine

  WITH_CSR:
    datatype  : int
    paramtype : vlogparam

provider:
  name    : github
  user    : olofk
  repo    : serv
  version : 1.1.0
