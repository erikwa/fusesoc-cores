CAPI=3:

name : ::i2c:1.15
description : WISHBONE revB.2 compliant I2C controller

# CAPI=2 selected some files by the top level's tool (`tool_<name>` flags).
# CAPI=3 has no tool in its context, so a top level building this core with
# that tool sets its variable: `vars: {tool_verilator: true}` in its
# target, or `--var +tool_verilator` on the command line.
vars:
  tool_verilator:
    datatype: bool
    default: false
    description: The top level builds with Verilator

filesets:
  rtl_files:
    files:
      - rtl/verilog/i2c_master_bit_ctrl.v
      - rtl/verilog/i2c_master_byte_ctrl.v
      - rtl/verilog/i2c_master_defines.v: {is_include_file : true}
      - rtl/verilog/i2c_master_top.v
      - if: "vars.tool_verilator"
        add:
          - data/verilator_waiver.vlt: {file_type: vlt}
    file_type : verilogSource

  tb_files:
    depend:
      - ">=::vlog_tb_utils:1.0"
      - "::wiredelay"
    files:
      - bench/verilog/wb_master_model.v
      - bench/verilog/tst_bench_top.v
      - bench/verilog/i2c_slave_model.v
    file_type : verilogSource

  openlane: {files : [data/openlane.tcl : {file_type : tclSource}]}

targets:
  default:
    filesets : [rtl_files]
  lint:
    vars: {tool_verilator: true}
    flow: lint
    flags: {tool: verilator}
    filesets : [rtl_files]
    flow_options:
      tool: verilator
      mode : lint-only
    toplevel : i2c_master_top
  sim:
    vars: {tool_icarus: true}
    flow: sim
    flags: {tool: icarus}
    flow_options:
      tool: icarus
    filesets : [rtl_files, tb_files]
    parameters : [WITH_VTU]
    toplevel : [tst_bench_top]

  # Not converted: CAPI=3 has only the flow API, and Edalize 0.6.8
  # has no flow-API implementation of `openlane`.
  # sky130:
  #   default_tool: openlane
  #   filesets: [rtl_files, openlane]
  #   toplevel: i2c_master_top

parameters:
  WITH_VTU:
    datatype : bool
    default : true
    description : "(Internal use: Enables vlog_tb_utils for tb control)"
    paramtype : vlogdefine

provider:
  name : github
  user : freecores
  repo : i2c
  version : v1.15
