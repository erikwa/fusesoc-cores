CAPI=3:

name : ::jtag_vpi:0-r3
description : TCP/IP controlled VPI JTAG Interface

# CAPI=2 selected some files by the top level's tool (`tool_<name>` flags).
# CAPI=3 has no tool in its context, so a top level building this core with
# that tool sets its variable: `vars: {tool_verilator: true}` in its
# target, or `--var +tool_verilator` on the command line.
vars:
  tool_verilator:
    datatype: bool
    default: false
    description: The top level builds with Verilator

filesets :
  common :
    files : [jtag_common.c, jtag_common.h : {is_include_file : true}]
    file_type : cSource

  vpi :
    files :
      - jtag_vpi.c : {file_type : cSource}
      - jtag_vpi.v : {file_type : verilogSource}

  verilator :
    files :
      - jtagServer.cpp
      - jtagServer.h : {is_include_file : true}
    file_type : cppSource

# CAPI=3 has no `vpi:`. Only Edalize's Tool API built VPI libraries, and the
# flow API, the only one CAPI=3 has, ignores them. Building the library again
# needs a generator that emits its sources and build rules (specification
# §7.6). Until then the VPI sources are still added to non-Verilator builds,
# but not compiled into a VPI library. The CAPI=2 core had:
#
# vpi:
#   jtag_vpi: {filesets : [common, vpi]}

targets :
  default:
    filesets :
      - common
      - if: "vars.tool_verilator"
        add: [verilator]
      - if: "!vars.tool_verilator"
        add: [vpi]
    parameters: [jtag_vpi_enable]

parameters:
  jtag_vpi_enable:
    datatype    : bool
    description : Enable JTAG debug interface
    paramtype   : plusarg

provider:
  name    : github
  user    : fjullien
  repo    : jtag_vpi
  version : 4155b223b2da7a9f835eb07c8adc6715680c3c51
